{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "jmad.bar",
    "layout": {
      "center": [
        {
          "alwaysShow": true,
          "id": "omarchy.indicators",
          "items": [
            "Reminder"
          ]
        },
        {
          "id": "omarchy.clock",
          "birthYear": 0,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 60,
          "verticalFormat": "HH\nmm"
        },
        {
          "hideClipboard": true,
          "hideHistory": true,
          "hideNotifications": true,
          "hideRecents": true,
          "hideWidgets": [
            "omarchy.tailscale"
          ],
          "id": "jmad.tally",
          "streamBrowser": "stream-browser.desktop"
        },
        {
          "id": "local.music"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "buttonSize": 18,
          "id": "jmad.workspaces",
          "leadingSpacing": 14,
          "rowSpacing": 6
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "local.quicksettings"
        },
        {
          "id": "jmad.power",
          "showPercentage": false
        }
      ]
    },
    "position": "right",
    "transparent": false
  },
  "cloneSourceRestores": [
    "jmad.background"
  ],
  "disabledPlugins": [
    "omarchy.background"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "jmad.background"
    }
  ],
  "version": 1
}
