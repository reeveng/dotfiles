#!/bin/bash

# Omarchy migrations edit ~/.config/waybar in place, which is how a hand made
# bar gets modules it never asked for. This puts the pinned bar back after an
# update, keeping whatever the update wrote so nothing is lost.
#
# After changing the bar on purpose, run: waybar-pin

PINNED="$HOME/.config/omarchy/pinned/waybar"
LIVE="$HOME/.config/waybar"
STAMP=$(date +%Y%m%d-%H%M%S)
restored=()

for file in config.jsonc style.css; do
  [[ -f $PINNED/$file ]] || continue
  cmp -s "$PINNED/$file" "$LIVE/$file" && continue

  cp -a "$LIVE/$file" "$PINNED/$file.from-update-$STAMP"
  cp -a "$PINNED/$file" "$LIVE/$file"
  restored+=("$file")
done

if ((${#restored[@]})); then
  omarchy-restart-waybar
  notify-send -u low "Waybar restored" \
    "The update changed ${restored[*]}. Your pinned bar is back; the update's version is in ~/.config/omarchy/pinned/waybar."
fi
