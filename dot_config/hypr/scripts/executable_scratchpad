#!/bin/bash

# Toggle a named special workspace, launching what belongs in it the first time.
#
#   scratchpad term                 a bare terminal, over whatever you are doing
#   scratchpad music kew            a terminal running kew
#   scratchpad notes -- obsidian    a window that is not a terminal
#
# A special workspace floats above the current one and leaves it untouched, so
# whatever is in here keeps running when you dismiss it.
#
# hyprctl dispatch takes Lua now, so the window rule is an argument to
# hl.dsp.exec_cmd rather than a bracketed prefix on the command string.

set -e

name="$1"
shift || true

occupied() {
  hyprctl clients -j | jq -e --arg w "special:$name" 'any(.[]; .workspace.name == $w)' >/dev/null
}

lua_string() {
  printf '"%s"' "${1//\"/\\\"}"
}

launch() {
  local command

  if [[ ${1-} == "--" ]]; then
    shift
    command="$*"
  else
    command="${TERMINAL:-alacritty} ${*:+-e $*}"
  fi

  hyprctl dispatch "hl.dsp.exec_cmd($(lua_string "$command"), { workspace = $(lua_string "special:$name silent") })"

  for _ in {1..60}; do
    occupied && return 0
    sleep 0.05
  done
}

occupied || launch "$@"
hyprctl dispatch "hl.dsp.workspace.toggle_special($(lua_string "$name"))"
