#!/bin/bash

# While OBS is streaming: notifications stay quiet and the screen does not lock
# itself. When the stream ends, or OBS dies, both go back exactly as they were.
#
# The stream state comes from obs-stream-state, the same source the bar dot
# uses. Do not disturb and the idle lock both live in the Omarchy shell now;
# the older mako and hypridle this drove are no longer on the machine.

INTERVAL="${OBS_WATCH_INTERVAL:-2}"

silenced=0
idle_held=0
live=0

streaming() {
  [[ $(obs-stream-state) == "live" ]]
}

dnd_is_on() {
  [[ $(omarchy-shell notifications isDnd 2>/dev/null) == "on" ]]
}

stay_awake_is_on() {
  omarchy-toggle-idle status 2>/dev/null | grep -q '"enabled":true'
}

hold() {
  notify-send -u low "󰑋  Live" "Notifications silenced, screen will not lock"

  if ! dnd_is_on; then
    omarchy-shell notifications setDnd true >/dev/null 2>&1 && silenced=1
  fi

  if ! stay_awake_is_on; then
    omarchy-toggle-idle stay-awake >/dev/null 2>&1 && idle_held=1
  fi
}

release() {
  ((silenced)) && omarchy-shell notifications setDnd false >/dev/null 2>&1
  ((idle_held)) && omarchy-toggle-idle allow-idle >/dev/null 2>&1
  silenced=0
  idle_held=0

  notify-send -u low "󰑋  Stream ended" "Notifications and idle lock are back"
}

trap 'release; exit 0' TERM INT

while true; do
  if streaming; then
    ((live)) || {
      hold
      live=1
    }
  elif ((live)); then
    release
    live=0
  fi
  sleep "$INTERVAL"
done
